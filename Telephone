#include <iostream>
#include <string>
#include <vector>
#include <iomanip>





using namespace std;


class Smartphone {
public:

	string brand;
	string model;
	string OS;
	float verOS;
	bool call;
	bool pressedButton;
	bool inputHeadphon;
	Smartphone(string brand, string model, string OS, float verOS, bool call, bool pressedButton, bool inputHeadphon)
	{
		this->brand = brand;
		this->model = model;
		this->verOS = verOS;
		this->OS = OS;
		this->call = call;
		this->pressedButton = pressedButton;
		this->inputHeadphon = inputHeadphon;
	}

	void ring(Smartphone& smartphone) {
		if (smartphone.call == true)
		{
			cout << "Смартфон: Бззззз" << endl;
		}
		else
			cout << "Смартфон в состоянии спокойствия" << endl;
	}

	void work(Smartphone& smartphone) {
		if (smartphone.pressedButton == true)
		{
			cout << "Экран смартфона загорелся" << endl;
		}
		else
			cout << "Экран телефона выключен" << endl;
	}

	void onHeadphone(Smartphone& smartphone) {
		if (smartphone.inputHeadphon == true)
		{
			cout << "Наушники подключены" << endl;
		}
		else
			cout << "Наушники отключены" << endl;
	}
};
