	bool f = false;
	bool h = false;

	while (a != '0')
	{
		cout << "Нажать кнопку блокировки экрана? Y/N" << endl;
		cin >> b;
		if (b == 'Y' || b == 'y')
		{
			c = true;
		}
		if (b == 'N' || b == 'n')
		{
			c = false;
		}

		cout << "Попросить друга позвонить на ваш телефон? Y/N" << endl;
		cin >> d;
		if (d == 'Y' || d == 'y')
		{
			f = true;
		}
		if (d == 'N' || d == 'n')
		{
			f = false;
		}

		cout << "Подключить наушники к телефону? Y/N" << endl;
		cin >> w;
		if (w == 'Y' || w == 'y')
		{
			h = true;
		}
		if (w == 'N' || w == 'n')
		{
			h = false;
		}
		system("cls");

		cout << "Системные сведения и состояние телефона: " << endl << endl;
		Smartphone smartphone("Honor", "8X", "Android", 16.1, f, c, h);
		cout << setw(10) << "Бренд: " << setw(12) << smartphone.brand << endl;
		cout << setw(10) << "Модель: " << setw(12) << smartphone.model << endl;
